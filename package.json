{
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rimraf dist app/ui_compiled app/app_compiled",
    "generate-shared": "npx tsc --ignoreConfig --module commonjs --target es2020 ui/rpcChannels.ts ui/rollbarConfig.ts ui/storageConfig.ts --outDir app/src",
    "build-common": "npm run generate-shared && ng build && cd app && npm run build",
    "build": "node createEnv.js dev && npm run build-common",
    "serve": "ng serve",
    "build-prod": "npm run lint && npm run clean && node createEnv.js prod && npm run build-common",
    "electron": "electron app",
    "dist-win": "npm run build-prod && electron-builder --win --publish always",
    "dist-mac": "npm run build-prod && electron-builder --mac --publish always",
    "dist-linux": "npm run build-prod && electron-builder --linux --publish always",
    "postinstall": "electron-builder install-app-deps && cd app && npm install",
    "lint": "npm run generate-shared && ng lint",
    "lint-fix": "npm run generate-shared && ng lint --fix"
  },
  "build": {
    "appId": "play.your.damn.turn.client",
    "afterSign": "scripts/notarize.js",
    "mac": {
      "category": "public.app-category.strategy-games",
      "artifactName": "playyourdamnturn-mac-${version}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "default",
          "arch": "universal"
        }
      ]
    },
    "win": {
      "artifactName": "playyourdamnturn-win-${version}.${ext}",
      "executableName": "PydtClient",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "azureSignOptions": {
        "publisherName": "Rosack Software Solutions, LLC",
        "endpoint": "https://eus.codesigning.azure.net/",
        "certificateProfileName": "rss-public",
        "codeSigningAccountName": "rss-trusted-signing"
      }
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "category": "StrategyGame",
      "artifactName": "playyourdamnturn-linux-${version}-${arch}.${ext}",
      "target": "AppImage"
    },
    "files": [
      "!node_modules",
      "app_compiled/**/*",
      "ui_compiled/**/*",
      "**/*.png"
    ],
    "extraFiles": [
      "app/icon.png"
    ],
    "extraResources": [
      {
        "from": "app/mods",
        "to": "mods"
      }
    ]
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "repository": "https://github.com/pydt/client",
  "devDependencies": {
    "@angular-eslint/builder": "^22.8.0",
    "@angular-eslint/eslint-plugin": "^22.8.0",
    "@angular-eslint/eslint-plugin-template": "^22.8.0",
    "@angular-eslint/schematics": "^22.8.0",
    "@angular-eslint/template-parser": "^22.8.0",
    "@angular/animations": "^22.2.6",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@electron/notarize": "^3.1.1",
    "@types/node": "^25.5.0",
    "@types/plist": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "angular-eslint": "^22.8.0",
    "bootstrap": "^5.3.8",
    "electron": "^45.4.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "font-awesome": "4",
    "globals": "^17.14.0",
    "lodash-es": "^4.18.1",
    "marked": "^17.0.4",
    "ngx-bootstrap": "^22.0.0",
    "ngx-markdown": "^22.1.1",
    "prettier": "^3.2.5",
    "pydt-shared": "^2.2.0",
    "rimraf": "^6.1.3",
    "rollbar": "^4.2.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "webpack": "^5.105.4",
    "zone.js": "^0.16.3"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "electron@41.9.2": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.3": true
  }
}
